# Local development defaults (docker-compose in infra/docker)
# core-api connects as the RLS-enforced app role:
DATABASE_URL=postgres://inova_app:inova_app@localhost:5432/inova
# auth-service has its own role — the only one that reads credentials and sessions:
AUTH_DATABASE_URL=postgres://inova_auth:inova_auth@localhost:5432/inova
# The worker has its own role too (D21) — tenant-scoped, one organisation at a time:
WORKER_DATABASE_URL=postgres://inova_worker:inova_worker@localhost:5432/inova
# Migrations/seeds connect as the privileged role (local: docker superuser):
DATABASE_URL_MIGRATOR=postgres://inova:inova@localhost:5432/inova
REDIS_URL=redis://localhost:6379

# JWT signing (auth-service). Local dev auto-generates .keys/auth-dev-jwt.pem.
# JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# core-api fetches the JWKS from auth-service:
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=inova
S3_SECRET_KEY=inova-secret
S3_BUCKET=inova-dev

# Message delivery by the worker (D41). Locally every e-mail — and every SMS,
# rendered as an e-mail to <number>@sms.test — lands in MailHog:
# http://localhost:8025. Production names EMAIL_TRANSPORT (smtp or infobip).
SMTP_URL=smtp://localhost:1025
# EMAIL_TRANSPORT=smtp
# SMS_TRANSPORT=mailbox
# INFOBIP_BASE_URL=
# INFOBIP_API_KEY=
# RECOVERY_LINK_URL=http://localhost:4001/v1/auth/reset

# Reverse proxies in front of the services (0 locally, 1 behind the edge nginx).
# TRUST_PROXY_HOPS=0
# Strict per-client attempts per minute on login/activate/resend (a number).
# AUTH_THROTTLE_STRICT=5
# The worker writes codes to its log instead of sending them only with this
# opt-in (the seeded test environment, until it names a transport).
# CODE_DELIVERY=log
# Accounts are per organisation. A sign-in that names no organisation lands in
# this one; outside production it defaults to the seeded `inova`.
# AUTH_DEFAULT_REALM=inova
# Days an invite code stays valid (1–90, default 30). Read by auth-service and
# core-api; a value outside the bounds stops them at start-up.
# INVITE_CODE_TTL_DAYS=30
# Password recovery (auth-service): link 15–1440 minutes, SMS code 5–30
# minutes; a value outside the bounds stops it at start-up.
# RECOVERY_LINK_TTL_MINUTES=60
# RECOVERY_CODE_TTL_MINUTES=10

# Services
AUTH_SERVICE_PORT=4001
API_PORT=4000
# The worker serves only its health probe here.
WORKER_PORT=4002
