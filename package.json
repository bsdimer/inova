{
  "name": "inova",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "node scripts/assert-lint-ran.mjs && turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo build --filter=@inova/auth-service --filter=@inova/api && pnpm --filter @inova/admin test:e2e",
    "check:stubs": "node scripts/check-stubs.mjs",
    "check:brands": "node scripts/check-brands.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:agent-harness": "node scripts/check-agent-harness.mjs",
    "check:worklog": "node scripts/check-worklog.mjs",
    "check:admin": "pnpm --filter @inova/admin lint && pnpm --filter @inova/admin typecheck && pnpm --filter @inova/admin build",
    "verify": "node scripts/verify.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml,mjs,cjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml,mjs,cjs,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "argon2": "^0.44.0",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "pg": "^8.23.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ]
  }
}
