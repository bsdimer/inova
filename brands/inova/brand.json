{
  "$schema": "./brand.schema.json",
  "key": "inova",
  "name": "inova",
  "displayName": "inova",
  "company": {
    "legalName": "WhiteNova Technology"
  },
  "tagline": "Together. Better. Home.",
  "description": "Community management for apartment buildings and neighborhoods.",
  "values": ["neighborly", "trustworthy", "organized", "tech-forward"],
  "locales": {
    "default": "bg",
    "supported": ["bg", "en"]
  },
  "colors": {
    "orange": "#EB5E28",
    "orangeBright": "#FF7E47",
    "ember": "#C24A17",
    "foam": "#EFECE3",
    "cream": "#F7F4EC",
    "sand": "#E4DDCF",
    "goldBlack": "#1D1D1F",
    "espresso": "#2C2324",
    "landmark": "#766754",
    "stone": "#A79D90",
    "white": "#FFFFFF"
  },
  "gradients": {
    "primary": ["#FF7E47", "#EB5E28"],
    "accent": ["#EB5E28", "#C24A17"],
    "hero": ["#F7F4EC", "#EFECE3"]
  },
  "theme": {
    "light": {
      "background": "#EFECE3",
      "surface": "#FFFFFF",
      "surfaceMuted": "#F7F4EC",
      "textPrimary": "#1D1D1F",
      "textSecondary": "#766754",
      "border": "#E4DDCF",
      "primary": "#EB5E28",
      "success": "#2E9E6B",
      "accent": "#A79D90",
      "danger": "#D64545"
    },
    "dark": {
      "background": "#1D1D1F",
      "surface": "#2C2324",
      "surfaceMuted": "#3A322E",
      "textPrimary": "#F5F1E8",
      "textSecondary": "#A79D90",
      "border": "#3E3733",
      "primary": "#FF7E47",
      "success": "#4CBF8B",
      "accent": "#A79D90",
      "danger": "#FF6B61"
    }
  },
  "radius": {
    "sm": 12,
    "md": 18,
    "lg": 28,
    "pill": 999
  },
  "distribution": {
    "mode": "shared",
    "ios": {
      "bundleId": "bg.inova.resident"
    },
    "android": {
      "package": "bg.inova.resident"
    },
    "deepLinkDomain": "app.inova.bg",
    "scheme": "inova"
  },
  "features": {
    "payments": true,
    "issues": true,
    "notices": true,
    "surveys": false,
    "privileges": false,
    "aiIntegration": false,
    "documentSigning": false
  },
  "support": {
    "email": "support@inova.bg",
    "phone": "+359 000 000 000"
  }
}
