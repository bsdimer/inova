# syntax=docker/dockerfile:1.7
#
# Admin SPA (React 19 + Vite), served by nginx. Built from the repository root:
#   docker build -f infra/deploy/Dockerfile.admin .
#
# VITE_* values are compiled into the bundle, so they are build args. The
# defaults are relative paths, which keeps the image host-independent: it works
# behind any front proxy that exposes core-api under /api and auth under /auth.
ARG NODE_VERSION=22-alpine

FROM node:${NODE_VERSION} AS build
RUN corepack enable
WORKDIR /repo
ENV CI=1
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/admin/package.json apps/admin/
COPY apps/api/package.json apps/api/
COPY apps/auth-service/package.json apps/auth-service/
COPY apps/mobile/package.json apps/mobile/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter "@inova/admin..."
COPY tsconfig.base.json ./
# The admin imports @inova/shared (the sign-in form's checks), which is built
# to dist/ like for the services; "@inova/admin..." builds it first.
COPY packages/shared packages/shared
COPY apps/admin apps/admin
ARG VITE_API_URL=/api/v1
ARG VITE_AUTH_URL=/auth/v1
ENV VITE_API_URL=${VITE_API_URL} VITE_AUTH_URL=${VITE_AUTH_URL}
RUN pnpm --filter "@inova/admin..." build

FROM nginx:1.27-alpine AS runtime
COPY infra/deploy/nginx/admin-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/admin/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD \
  wget -q -O /dev/null http://127.0.0.1/ || exit 1
