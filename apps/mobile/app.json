{
  "expo": {
    "name": "inova",
    "slug": "inova",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "inova",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bg.inova.resident"
    },
    "android": {
      "package": "bg.inova.resident",
      "adaptiveIcon": {
        "backgroundColor": "#EFECE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#EFECE3",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложението използва галерията, за да прикачите снимка към сигнал.",
          "cameraPermission": "Приложението използва камерата, за да заснемете снимка към сигнал."
        }
      ]
    ]
  }
}
