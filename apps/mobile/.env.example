# Auth-service base URL (includes /v1). Copy to `.env` to override defaults.
#
# Deployed test stack (portal.whitenova.tech is not live yet — see AGENTS.md):
EXPO_PUBLIC_AUTH_URL=https://test-portal.whitenova.tech/auth/v1
#
# Local auth-service (iOS simulator). Android emulator: http://10.0.2.2:4001/v1
# EXPO_PUBLIC_AUTH_URL=http://localhost:4001/v1

# Organisation whose accounts the app signs in to. Unset: the server's default
# (`inova`). The sample residents for app development live in `demo`
# (db/seed.mjs: +359881000101…103, password demo-resident).
EXPO_PUBLIC_AUTH_REALM=demo
