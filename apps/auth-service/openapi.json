          },
          "400": {
            "description": "The request is malformed: a field is missing or invalid (`message` lists them).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the credentials, code or token are wrong. Always the same answer, whatever the reason.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts from this address; wait a minute.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Password login by e-mail or phone inside one realm (staff and activated residents)",
        "tags": ["auth"]
      }
    },
