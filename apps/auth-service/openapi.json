          "400": {
            "description": "The request is malformed: a field is missing or invalid (`message` lists them).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the credentials, code or token are wrong. Always the same answer, whatever the reason.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Rotate a refresh token (reuse revokes the token family)",
        "tags": ["auth"]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The session is ended; an unknown token is ignored"
          },
          "400": {
            "description": "The request is malformed: a field is missing or invalid (`message` lists them).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Revoke a refresh token family",
        "tags": ["auth"]
      }
    },
    "/v1/auth/password": {
      "post": {
        "operationId": "AuthController_setPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
